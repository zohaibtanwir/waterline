# Langfuse stack secrets — COPY to .env on the controller and fill CHANGEME values.
# .env is gitignored; this .example is the committed template.
# Aligned to the UPSTREAM langfuse docker-compose (docker-compose.deploy.yml).
# Vars not listed here use the compose's built-in defaults (safe: REDIS_HOST,
# POSTGRES_USER=postgres, TLS flags off, etc.) — only overrides live here.
#
# Generate secrets: openssl rand -hex 32   (base64 where noted)

# ---- Postgres (Langfuse app DB) ----
POSTGRES_PASSWORD=CHANGEME_hex32
# DATABASE_URL must embed the SAME password as POSTGRES_PASSWORD above.
# (Upstream default hardcodes 'postgres' as the password — must override.)
DATABASE_URL=postgresql://postgres:CHANGEME_SAME_AS_POSTGRES_PASSWORD@postgres:5432/postgres

# ---- ClickHouse ----
CLICKHOUSE_PASSWORD=CHANGEME_hex32

# ---- Redis ----
REDIS_AUTH=CHANGEME_hex32

# ---- MinIO (object storage) ----
MINIO_ROOT_PASSWORD=CHANGEME_hex32
# The S3 secret keys must all equal MINIO_ROOT_PASSWORD (single MinIO instance)
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME_SAME_AS_MINIO_ROOT_PASSWORD
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME_SAME_AS_MINIO_ROOT_PASSWORD
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGEME_SAME_AS_MINIO_ROOT_PASSWORD

# ---- Langfuse app secrets ----
NEXTAUTH_SECRET=CHANGEME_base64_32
SALT=CHANGEME_base64_32
ENCRYPTION_KEY=CHANGEME_hex32           # must be exactly 64 hex chars
NEXTAUTH_URL=http://100.98.245.52:3000  # tailnet IP of the controller
TELEMETRY_ENABLED=false

# ---- First-boot bootstrap: auto-create org, project, admin user, AND the
#      project API keys the gateway needs. Removes the manual browser step and
#      lets us know the Langfuse keys in advance. ----
LANGFUSE_INIT_ORG_ID=waterline
LANGFUSE_INIT_ORG_NAME=Waterline
LANGFUSE_INIT_PROJECT_ID=waterline-lab
LANGFUSE_INIT_PROJECT_NAME=Waterline Lab
# These two become the Langfuse keys the gateway logs with. Invent them now:
#   PUBLIC:  pk-lf-<openssl rand -hex 16>
#   SECRET:  sk-lf-<openssl rand -hex 16>
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME_hex16
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME_hex16
LANGFUSE_INIT_USER_EMAIL=CHANGEME@example.com
LANGFUSE_INIT_USER_NAME=Zohaib
LANGFUSE_INIT_USER_PASSWORD=CHANGEME_login_password
