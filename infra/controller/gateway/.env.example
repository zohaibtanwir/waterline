# LiteLLM gateway secrets — COPY to .env on the controller and fill CHANGEME values.
# .env is gitignored; this .example is the committed template.

# ---- The ONE real Anthropic key ----
# The waterline-gateway key, from the spend-limited waterline workspace.
ANTHROPIC_API_KEY=sk-ant-PASTE-WATERLINE-GATEWAY-KEY

# ---- Gateway admin key (WE invent this) ----
# Mints per-task virtual keys. Sandboxes NEVER see it. Must start with sk-.
# Generate: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-CHANGEME

# ---- Salt key — encrypts stored credentials in the DB ----
# CRITICAL: must PERSIST across redeploys. Rotating it invalidates every
# virtual key in flight. Generate ONCE: openssl rand -hex 32
LITELLM_SALT_KEY=CHANGEME_hex32_persist_forever

# ---- LiteLLM's own postgres (separate from Langfuse's) ----
LITELLM_DB_PASSWORD=CHANGEME_hex32
# DATABASE_URL must embed the SAME password as LITELLM_DB_PASSWORD
LITELLM_DATABASE_URL=postgresql://litellm:CHANGEME_SAME_AS_DB_PASSWORD@litellm-db:5432/litellm

# ---- Langfuse project keys ----
# The pk-lf-/sk-lf- keys created by the Langfuse init bootstrap (in the
# Langfuse .env as LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY).
LANGFUSE_PUBLIC_KEY=pk-lf-PASTE-FROM-LANGFUSE-ENV
LANGFUSE_SECRET_KEY=sk-lf-PASTE-FROM-LANGFUSE-ENV
