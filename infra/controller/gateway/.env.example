# LiteLLM gateway secrets — COPY to .env on the controller and fill in.
# .env is gitignored; this .example is the committed template.

# The ONE real Anthropic key — the waterline-gateway key, from the
# spend-limited waterline workspace on the Anthropic console.
ANTHROPIC_API_KEY=sk-ant-PASTE-WATERLINE-GATEWAY-KEY

# Admin key for the gateway itself — WE invent this. Sandboxes never see it;
# it's used to mint per-task virtual keys. Generate: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-CHANGEME

# LiteLLM's own postgres (separate from Langfuse's) — key store + spend ledger
LITELLM_DB_PASSWORD=CHANGEME_openssl_rand_hex_32
LITELLM_DATABASE_URL=postgresql://litellm:CHANGEME_SAME_AS_ABOVE@litellm-db:5432/litellm

# Langfuse project keys — created in the Langfuse UI (Settings -> API Keys)
# AFTER Langfuse is up and you've registered the admin account.
LANGFUSE_PUBLIC_KEY=pk-lf-PASTE-AFTER-LANGFUSE-UP
LANGFUSE_SECRET_KEY=sk-lf-PASTE-AFTER-LANGFUSE-UP
